{
  "expo": {
    "name": "Myntra",
    "slug": "Myntra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myntra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}