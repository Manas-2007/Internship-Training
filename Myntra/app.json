{
  "expo": {
    "name": "Myntra",
    "slug": "Myntra",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myntra",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f40b9f9-d764-4ad5-a9da-f1a43f012e5c"
      }
    },
    "android": {
      "package": "com.manas2007.Myntra"
    },
    "notifications": {
      "icon": "./assets/icon.png",
      "color": "#ff3f6c"
    }
  }
}
